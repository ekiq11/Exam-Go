rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sesi Ujian, Monitoring & Peserta Ujian
    match /exam_sessions/{document=**} {
      allow read, write: if true;
    }

    // Paket Tryout, Subtest & Butir Soal (Cegah penghapusan dari client publik; Admin WebGAS via Service Account tetap penuh)
    match /paket_tryout/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /subtest/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /tryout_soal/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Jawaban, Riwayat, Leaderboard & Penyelesaian Event Siswa
    match /jawaban_tryout/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /student_tryout_history/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /tryout_leaderboards/{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /event_completions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Token Lisensi Lynk.id: Blokir list/dump semua token, pembuatan token palsu, dan pembajakan 1-device lock
    match /license_tokens/{tokenId} {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if request.resource.data.type == resource.data.type &&
        (resource.data.is_group_voucher == true ||
         resource.data.is_used != true ||
         resource.data.device_id == null ||
         resource.data.device_id == "" ||
         request.resource.data.device_id == resource.data.device_id);

      match /activated_devices/{deviceId} {
        allow get, create, update: if true;
        allow list, delete: if false;
      }
    }

    match /premium_activations/{tokenId} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }

    match /partner_schools/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Pengaturan Aplikasi & Landing Page: Hanya baca dari client, tulis hanya via Service Account Admin WebGAS
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Data Perangkat Siswa/Guru: Blokir list/dump seluruh perangkat
    match /devices/{deviceId} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
  }
}

