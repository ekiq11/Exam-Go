rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sesi Ujian, Monitoring & Peserta Ujian
    match /exam_sessions/{document=**} {
      allow read, write: if true;
    }
    
    // Paket Tryout, Subtest & Butir Soal (Native ExamGO)
    match /paket_tryout/{document=**} {
      allow read, write: if true;
    }
    match /subtest/{document=**} {
      allow read, write: if true;
    }
    match /tryout_soal/{document=**} {
      allow read, write: if true;
    }

    // Jawaban & Rekap Nilai Siswa
    match /jawaban_tryout/{document=**} {
      allow read, write: if true;
    }
    
    // Token Lisensi Lynk.id (Guru & Siswa) & Sekolah Mitra
    match /license_tokens/{document=**} {
      allow read, write: if true;
    }
    match /partner_schools/{document=**} {
      allow read, write: if true;
    }

    // Pengaturan Aplikasi & Landing Page
    match /app_settings/{document=**} {
      allow read, write: if true;
    }
    
    // Riwayat Kuota & Data Perangkat Siswa/Guru
    match /devices/{document=**} {
      allow read, write: if true;
    }
  }
}

