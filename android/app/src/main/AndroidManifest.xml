<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══ Permissions ══════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Biometrik (Fingerprint / Face Unlock) — digunakan di teacher_mode.dart -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Notifikasi Lokal & FCM Background -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ══ Camera hardware — optional ══ -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:label="ExamGO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="false"
            android:lockTaskMode="if_whitelisted"
            android:excludeFromRecents="false">
            <!--
                ANTI SPLIT SCREEN:
                - resizeableActivity="false": sinyal ke Android bahwa activity tidak
                  mendukung multi-window. Efektif di Android 7.1+ (API 25+).
                - supportsPictureInPicture="false": blokir PiP mode juga.
                - lockTaskMode="if_whitelisted": saat device admin aktif, app bisa
                  masuk Lock Task penuh yang secara hardware memblokir split screen.

                CATATAN Android 7.0 (API 24):
                resizeableActivity="false" pada API 24 tidak 100% mencegah split screen.
                Ini ditangani di kode (onMultiWindowModeChanged override di MainActivity.kt).
            -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Agar tap notifikasi dari flutter_local_notifications membuka app -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <!--
            FIX BUG #4: ExamDeviceAdminReceiver TIDAK terdaftar di manifest lama.
            Tanpa entry ini, requestDeviceAdmin() di KioskMethodChannel TIDAK
            pernah berjalan → enableKioskMode() selalu return false →
            Lock Task Mode tidak pernah aktif di SEMUA perangkat.

            Receiver ini WAJIB terdaftar dengan:
              - action DEVICE_ADMIN_ENABLED  agar system bisa mengaktifkannya
              - meta-data device_admin agar dapat policy yang benar
        -->
        <receiver
            android:name=".ExamDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Flutter embedding v2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 
            FCM: Default Notification Channel.
            Penting agar notifikasi background yang punya key 'notification'
            menggunakan channel ini oleh sistem operasi (bisa getar + suara)
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="exam_violations" />

        <!--
            FIX: gralloc4 "Format allocation info not found for format: 0x38/0x3b"
                 MALI BAD ALLOC from gles_texture_egl_image_get_2d_template
                 GPUAUX "Null anb"

            Root cause: FLAG_SECURE (di MainActivity) memicu sistem untuk
            mengalokasikan secure surface dengan pixel format 0x38 (RGBA_1010102)
            dan 0x3b (RGBX_1010102) yang TIDAK DIDUKUNG oleh gralloc4 di
            chipset MediaTek / Samsung Exynos tertentu. Alokasi gagal →
            MALI tidak dapat membuat EGLImage dari buffer → BAD ALLOC loop.

            Fix: MetricsOptOut mendorong WebView ke single-process mode,
            mengurangi jumlah surface/buffer yang perlu dialokasikan,
            dan menghilangkan kompetisi format antar compositor.
        -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!--
            FIX: "Already have a pending vsync event" (Choreographer)

            Nonaktifkan multiprocess WebView renderer — di single-process mode,
            WebView berbagi Choreographer thread dengan Flutter sehingga
            tidak ada double vsync request di frame pertama.

            Juga menghilangkan GPUAUX Null anb karena tidak ada
            inter-process surface handoff yang gagal.
        -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

    </application>

    <!-- Allow opening https/http URLs from WebView -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

</manifest>