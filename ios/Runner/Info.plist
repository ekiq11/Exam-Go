<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ╔══════════════════════════════════════════════════════════════╗
  ║  ExamGO — ios/Runner/Info.plist                             ║
  ║  Tambahkan KEY-VALUE berikut ke dalam <dict> yang sudah ada ║
  ╚══════════════════════════════════════════════════════════════╝
-->
<plist version="1.0">
<dict>

  <!-- ══════════════════════════════════════════════════════════
       IZIN KAMERA — wajib untuk QR Scanner
       Teks ini ditampilkan iOS saat meminta izin pertama kali
       ══════════════════════════════════════════════════════════ -->
  <key>NSCameraUsageDescription</key>
  <string>ExamGO memerlukan akses kamera untuk memindai QR Code ujian. Kamera hanya aktif saat halaman scan dibuka.</string>

  <!-- ══════════════════════════════════════════════════════════
       IZIN GALERI / FOTO — untuk scan QR dari gambar
       ══════════════════════════════════════════════════════════ -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>ExamGO memerlukan akses galeri foto untuk memindai QR Code dari gambar yang tersimpan.</string>

  <!-- ══════════════════════════════════════════════════════════
       IZIN TAMBAH KE GALERI — opsional, jika app menyimpan QR
       ══════════════════════════════════════════════════════════ -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>ExamGO dapat menyimpan QR Code ujian yang digenerate ke galeri foto Anda.</string>

  <!-- ══════════════════════════════════════════════════════════
       TAMPILAN LAYAR PENUH (iOS Safe Area)
       Agar app bisa menggunakan seluruh layar termasuk notch
       ══════════════════════════════════════════════════════════ -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>

  <!-- ══════════════════════════════════════════════════════════
       ORIENTASI — hanya portrait (sesuai SecurityService)
       ══════════════════════════════════════════════════════════ -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
  </array>

  <!-- ══════════════════════════════════════════════════════════
       JARINGAN — izinkan koneksi HTTP (jika server ujian pakai HTTP)
       Hapus bagian ini jika semua server sudah HTTPS
       ══════════════════════════════════════════════════════════ -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- Pilih SALAH SATU opsi di bawah: -->

    <!-- OPSI A (Direkomendasikan): Izinkan semua domain — untuk server ujian beragam -->
    <key>NSAllowsArbitraryLoads</key>
    <true/>

    <!-- OPSI B (Lebih aman): Whitelist domain spesifik saja
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>ujian.kemenag.go.id</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
    </dict>
    -->
  </dict>

  <!-- ══════════════════════════════════════════════════════════
       FIREBASE — diperlukan untuk Google Sign-In / Analytics
       ══════════════════════════════════════════════════════════ -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <!-- Ganti dengan REVERSED_CLIENT_ID dari GoogleService-Info.plist -->
        <string>com.googleusercontent.apps.GANTI_DENGAN_REVERSED_CLIENT_ID</string>
      </array>
    </dict>
  </array>

  <!-- ══════════════════════════════════════════════════════════
       NAMA APP DI HOME SCREEN
       ══════════════════════════════════════════════════════════ -->
  <key>CFBundleDisplayName</key>
  <string>ExamGO</string>

</dict>
</plist>