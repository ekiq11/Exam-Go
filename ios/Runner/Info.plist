<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ══ Core Flutter/iOS Keys ═══════════════════════════════════ -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ExamGO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>examgo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ══ Permissions ══════════════════════════════════════════════
	     Mapping dari AndroidManifest:
	       CAMERA                → NSCameraUsageDescription
	       READ_EXTERNAL_STORAGE → NSPhotoLibraryUsageDescription
	       WAKE_LOCK             → isIdleTimerDisabled di AppDelegate (runtime)
	       INTERNET              → NSAppTransportSecurity (HTTPS-only)
	       ACCESS_NETWORK_STATE  → tidak perlu, auto-granted di iOS
	     ══════════════════════════════════════════════════════════ -->

	<!-- Kamera — setara uses-permission CAMERA + uses-feature camera optional -->
	<key>NSCameraUsageDescription</key>
	<string>ExamGO memerlukan akses kamera untuk memindai QR Code ujian. Kamera hanya aktif saat halaman scan dibuka.</string>

	<!-- Mikrofon — diperlukan oleh SDK WebView/WebKit untuk kompatibilitas audio/video ujian CBT -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ExamGO memerlukan akses mikrofon apabila sesi ujian CBT berbasis web sekolah membutuhkan input suara atau verifikasi audio peserta.</string>

	<!-- Lokasi — diperlukan oleh SDK WebView untuk validasi geofencing lokasi ujian sekolah -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ExamGO dapat menggunakan lokasi saat aplikasi aktif untuk memverifikasi bahwa siswa berada di area sekolah atau laboratorium ujian yang telah ditentukan.</string>

	<!-- Face ID — untuk autentikasi Mode Guru -->
	<key>NSFaceIDUsageDescription</key>
	<string>ExamGO menggunakan Face ID untuk memverifikasi identitas guru sebelum mengakses Mode Guru.</string>

	<!-- Mikrofon — untuk soal ujian yang berisi audio/rekaman suara -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Izinkan ExamGO menggunakan mikrofon hanya saat soal ujian meminta jawaban berupa suara. Di halaman lain, mikrofon tidak akan pernah aktif.</string>

	<!-- Lokasi saat digunakan — untuk melampirkan lokasi pada foto yang diambil saat mengumpulkan jawaban -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Izinkan ExamGO mengetahui lokasi Anda hanya saat mengambil foto untuk jawaban ujian, agar foto terlampir informasi lokasi sekolah. Lokasi Anda tidak dilacak di luar itu.</string>

	<!-- Galeri baca — setara READ_EXTERNAL_STORAGE (maxSdkVersion 32) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ExamGO memerlukan akses galeri foto untuk memindai QR Code dari gambar yang tersimpan.</string>

	<!-- Galeri tulis — untuk simpan QR Code yang di-generate guru/pengawas -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ExamGO dapat menyimpan QR Code ujian yang digenerate ke galeri foto Anda.</string>

	<!-- ══ Jaringan ═════════════════════════════════════════════════
	     Setara android:usesCleartextTraffic="false" di AndroidManifest.
	     HTTPS-only untuk semua koneksi. Jika server ujian masih HTTP,
	     tambahkan exception domain di bawah ini.
	     ══════════════════════════════════════════════════════════ -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- Izinkan WKWebView memuat halaman CBT sekolah tanpa mematikan proteksi HTTPS untuk API aplikasi -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!--
		    Jika ada server ujian internal yang masih HTTP, uncomment dan
		    sesuaikan domain di bawah ini:

		    <key>NSExceptionDomains</key>
		    <dict>
		        <key>ujian.sekolah.sch.id</key>
		        <dict>
		            <key>NSExceptionAllowsInsecureHTTPLoads</key>
		            <true/>
		            <key>NSIncludesSubdomains</key>
		            <true/>
		        </dict>
		    </dict>
		-->
	</dict>

	<!-- ══ WebView — setara android.webkit.WebView.MetricsOptOut ════
	     Nonaktifkan Web Inspector di production build.
	     Setara AndroidWebViewController.enableDebugging(false).
	     wk.setInspectable(false) sudah dilakukan di qris_web_view.dart,
	     key ini sebagai failsafe di level plist.
	     ══════════════════════════════════════════════════════════ -->
	<key>WebKitDeveloperExtrasEnabledPreferenceKey</key>
	<false/>

	<!-- Blok window.open() dari JS — setara Safe Browsing dinonaktifkan -->
	<key>WebKitJavaScriptCanOpenWindowsAutomatically</key>
	<false/>

	<!-- ══ Orientasi — setara android:screenOrientation="portrait" ══ -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- iPad: portrait only — konsisten dengan iPhone dan Android -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- ══ UI ═══════════════════════════════════════════════════════
	     WAKE_LOCK equivalent:
	     UIApplication.shared.isIdleTimerDisabled = true
	     diaktifkan saat kiosk/ujian mulai di AppDelegate.swift
	     ══════════════════════════════════════════════════════════ -->
	<!-- ANTI SPLIT SCREEN (iPadOS) — Cegah Slide Over dan Split View -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- ══ Background Modes (FCM) ═══════════════════════════════════ -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ══ Firebase / Google Sign-In URL Scheme ════════════════════ -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.app-1-607855529793-ios-3a3b85a80bbd256a0c1bc0</string>
			</array>
		</dict>
	</array>

	<!-- ══ Whitelist URL Schemes untuk WhatsApp, Web, Email, Tel ══ -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>whatsapp</string>
		<string>mailto</string>
		<string>tel</string>
	</array>

</dict>
</plist>
